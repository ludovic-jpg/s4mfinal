# Copier ce fichier en « .env » puis adapter. Le fichier .env n'est JAMAIS versionné.

# Port de l'API locale
PORT=3001

# Base de données.
#   - vide ou chemin de dossier  -> PostgreSQL embarqué (PGlite), aucune installation requise
#   - postgres://...             -> serveur PostgreSQL (production)
DATABASE_URL=./donnees/base

# Dossier racine de l'archive des pièces (« Pièces de départ » / « Retour »)
ARCHIVE_DIR=./donnees/archive

# Première ouverture d'une base vide :
#   demonstration -> jeu de données fictives, quatre comptes prêts à l'emploi (défaut)
#   vide          -> un organisme à configurer + le premier administrateur ci-dessous
AMORCE=demonstration
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# URL publique de l'application (liens d'invitation dans les e-mails)
APP_URL=

# E-mails : « boite-locale » (rien ne part, tout est journalisé) ou « smtp »
COURRIER_MODE=boite-locale
SMTP_URL=
COURRIER_EXPEDITEUR=

# Chemin d'un Chromium pour la conversion HTML -> PDF (facultatif ; à défaut, la pièce reste en HTML imprimable)
CHROMIUM_PATH=

# Assistant IA de l'espace pédagogique (facultatif) : propose des QCM, des objectifs et un programme,
# que le formateur relit avant d'enregistrer. Jamais utilisé pour les conventions ni les pièces.
# Clé : https://console.anthropic.com · Nom du modèle : voir https://docs.claude.com (page « Models »).
ANTHROPIC_API_KEY=
IA_MODELE=
# « oui » : l'IA mène une recherche web avant de rédiger un parcours ou un support (plus long, plus coûteux)
IA_RECHERCHE_WEB=non

# Compte formateur « pilote » vérifié à chaque démarrage (créé s'il manque, candidature validée).
# Laisser COMPTE_PILOTE_EMAIL vide pour ne pas le créer. Changez ce mot de passe avant toute mise en ligne.
COMPTE_PILOTE_EMAIL=ludoalbisser@gmail.com
COMPTE_PILOTE_MOT_DE_PASSE=1234ludo
COMPTE_PILOTE_PRENOM=Ludovic
COMPTE_PILOTE_NOM=Albisser
